{
  "name": "sehatai-backend",
  "version": "1.0.0",
  "description": "SehatAI backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@prisma/client": "5.x",
    "bcrypt": "5.x",
    "cors": "2.x",
    "dotenv": "16.x",
    "express": "4.x",
    "express-rate-limit": "^8.6.2",
    "helmet": "7.x",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.x",
    "zod": "3.x"
  },
  "devDependencies": {
    "@types/bcrypt": "5.x",
    "@types/cors": "^2.8.19",
    "@types/express": "4.x",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "9.x",
    "@types/morgan": "1.x",
    "@types/node": "20.x",
    "prisma": "5.x",
    "tsx": "4.x",
    "typescript": "5.x"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
