// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  magicLinkTokens   MagicLinkToken[]
  onboardingResponse OnboardingResponse?
  chapterProgress   ChapterProgress[]
  stats             UserStats?
  savedWorkflows    SavedWorkflow[]
  usageLogs         UsageLog[]
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingResponse {
  id            String   @id @default(cuid())
  userId        String   @unique
  confidence    String   // beginner | some | confident
  challenges    String[] // array of: docs | summaries | comms | coord | prompteng
  goal          String   // confident | time | prompts | verify | compliant | cme
  timeCadence   String   // 2 | 5 | 10
  completedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chapter {
  id        String   @id @default(cuid())
  track     String   // 'prompt' | 'hall' | 'promptlab_dummy'
  index     Int
  title     String
  paras     String[]
  key       String
  reward    Int
  quiz      Json     // array of { q, opts, correct, explain, id?, type?, mistake_tag?, better_prompt? }
  example   Json?    // { weakPrompt: string, weakOutput: string, strongPrompt: string, strongOutput: string }
  createdAt DateTime @default(now())

  @@unique([track, index])
}

model ChapterProgress {
  id           String   @id @default(cuid())
  userId       String
  track        String   // 'prompt' | 'hall' | 'promptlab_dummy'
  chapterIndex Int
  completedAt  DateTime @default(now())
  quizScore    Int
  creditsEarned Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track, chapterIndex])
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  creditsTotal   Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedWorkflow {
  id          String   @id @default(cuid())
  userId      String
  task        String
  description String?
  output      String   // the full generated workflow text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   // e.g., 'prompt.improve', 'scribe.translate', 'workflow.generate'
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
