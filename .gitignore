# Dependencies
node_modules/
**/node_modules/

# Environment variables — NEVER commit real secrets (Neon DB URL, Resend/Anthropic keys, JWT secret)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
# .env.example files ARE safe and meant to be committed (placeholder values only)
!.env.example
!**/.env.example

# Build output
dist/
dist-ssr/
build/
**/dist/
**/dist-ssr/
**/build/

# TypeScript
*.tsbuildinfo
**/*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
coverage/

# Claude Code local plan files (session-specific, not project source)
.claude/settings.local.json
